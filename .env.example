# Local classroom/demo values only. Replace passwords and JWT key if this machine is shared.
MYSQL_DATABASE=novadent_demo
MYSQL_USER=novadent_app
MYSQL_PASSWORD=demo-only-change-this-password
MYSQL_ROOT_PASSWORD=demo-only-change-this-root-password
MYSQL_HOST=localhost
MYSQL_PORT=3306

# Valid 32-byte demo key; never reuse in a deployed environment.
JWT_SECRET_BASE64=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# Optional local account emails. Keep APP_MAIL_ENABLED=false until SMTP is configured privately.
APP_MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
APP_FRONTEND_BASE_URL=http://localhost:5174
