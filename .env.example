# Local classroom/demo values only. Replace passwords and JWT key if this machine is shared.
MYSQL_DATABASE=novadent_demo
MYSQL_USER=novadent_app
MYSQL_PASSWORD=demo-only-change-this-password
MYSQL_ROOT_PASSWORD=demo-only-change-this-root-password
MYSQL_HOST=localhost
MYSQL_PORT=3306

# Valid 32-byte demo key; never reuse in a deployed environment.
JWT_SECRET_BASE64=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# DR. ANNIE sandbox key for local tests only (10 requests/min, watermarked results).
# Request a production key from HCDS; keep API keys on the backend, never in the frontend.
ANNIE_API_KEY=SANDBOX_KEY_FOR_TESTING_ONLY
ANNIE_BASE_URL=https://api.annie-insights.com/api/v2

# Almacenamiento privado S3 compatible (AWS S3, Cloudflare R2 o MinIO).
# Dejalo en false hasta crear bucket y configurar credenciales en el .env local.
S3_STORAGE_ENABLED=false
# AWS: dejá S3_ENDPOINT vacío. R2: https://<account-id>.r2.cloudflarestorage.com
# MinIO: endpoint HTTPS público accesible por DR. ANNIE; localhost no sirve.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PATH_STYLE_ACCESS=false
S3_PRESIGNED_URL_TTL_SECONDS=900
S3_MAX_OBJECT_SIZE_BYTES=26214400
