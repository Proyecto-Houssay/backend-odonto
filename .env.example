# Local development defaults. Use separate credentials and a persistent MySQL service in production.
MYSQL_DATABASE=novadent
MYSQL_USER=novadent_app
MYSQL_PASSWORD=demo-only-change-this-password
MYSQL_ROOT_PASSWORD=demo-only-change-this-root-password
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_SSL_MODE=REQUIRED
JPA_DATABASE_PLATFORM=org.hibernate.dialect.MySQLDialect

# Valid 32-byte demo key; never reuse in a deployed environment.
JWT_SECRET_BASE64=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# Optional local account emails. Keep APP_MAIL_ENABLED=false until SMTP is configured privately.
APP_MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
MAIL_SMTP_STARTTLS_REQUIRED=true
APP_FRONTEND_BASE_URL=http://localhost:5174

# Configuración del Asistente IA / Chatbot RAG
# Si no se define OPENAI_API_KEY, el chatbot opera automáticamente con el motor autónomo de fuentes aprobadas en memoria.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
CHATBOT_KNOWLEDGE_DIRECTORY=./data/knowledge
CHATBOT_MINIMUM_SIMILARITY=0.65

# Google Gemini API for Dra. Ziegler. Keep the key private and backend-only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
